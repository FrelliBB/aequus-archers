---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Page from "../layouts/Page.astro";
import PersonCard from "../components/PersonCard.astro";
import { photo } from "../lib/images";

const people = (await getCollection("team")).map((p) => p.data).sort((a, b) => a.order - b.order);
const profiles = people.filter((p) => p.bio);
const coaches = people.filter((p) => !p.bio && p.group === "coach");
const committee = people.filter((p) => !p.bio && p.group === "committee");
const alt = (p: { name?: string; role: string }) =>
	p.name ? `${p.name}, ${p.role}` : `${p.role} at Aequus Archers`;
---

<Page
	title="Meet the team"
	description="Meet the friendly volunteer committee and qualified coaching team who run Aequus Archers."
	intro="We’re a volunteer-run club, and it’s our people who make it so welcoming — meet the coaches who’ll get you started and the committee who keep things running."
>
	<section>
		<h2>Our committee &amp; coaches</h2>
		<p>
			Everything at Aequus Archers is run by volunteers who give their time because they love the
			sport and the community around it. Whether you’re booking your first taster or settling in as
			a member, these are some of the friendly faces you’ll meet.
		</p>

		{
			profiles.map((p) => (
				<article class="profile">
					{p.photo && (
						<Image class="profile-photo" src={photo(p.photo)} alt={alt(p)} widths={[260, 480]} sizes="260px" />
					)}
					<div class="profile-body">
						<div class="role">{p.role}</div>
						<h3 class="name">{p.name}</h3>
						{p.bio!.split(/\n\s*\n/).map((para) => <p>{para}</p>)}
					</div>
				</article>
			))
		}
	</section>

	{
		coaches.length > 0 && (
			<section>
				<h2>Our coaches</h2>
				<p class="muted">Every session is led by an experienced, Archery GB–qualified coach.</p>
				<div class="card-grid">
					{coaches.map((p) => (
						<PersonCard role={p.role} name={p.name} summary={p.summary} photo={p.photo} />
					))}
				</div>
			</section>
		)
	}

	{
		committee.length > 0 && (
			<section>
				<h2>Our committee</h2>
				<p class="muted">The volunteers who keep the club running.</p>
				<div class="card-grid">
					{committee.map((p) => (
						<PersonCard role={p.role} name={p.name} summary={p.summary} photo={p.photo} />
					))}
				</div>
			</section>
		)
	}

	<style>
		.profile {
			display: grid;
			grid-template-columns: 260px 1fr;
			gap: 40px;
			align-items: start;
			margin-top: 28px;
			background: var(--card);
			border-radius: var(--radius-l);
			padding: 32px;
		}
		.profile + .profile {
			margin-top: 24px;
		}
		.profile-photo {
			width: 100%;
			aspect-ratio: 3 / 4;
			object-fit: cover;
			border-radius: var(--radius-photo);
			box-shadow: 12px 12px 0 var(--butter);
			background: var(--paper-deep);
		}
		.role {
			font-family: var(--font-display);
			font-style: italic;
			color: var(--coral-deep);
		}
		.profile-body .name {
			font-size: 2rem;
			margin: 2px 0 14px;
		}
		.profile-body p {
			max-width: 62ch;
		}
		@media (max-width: 640px) {
			.profile {
				grid-template-columns: 1fr;
				gap: 24px;
				padding: 24px 20px;
			}
			.profile + .profile {
			margin-top: 24px;
		}
		.profile-photo {
				max-width: 240px;
			}
		}
	</style>
</Page>
