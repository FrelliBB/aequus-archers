---
import Page from "../layouts/Page.astro";
import { INSTAGRAM_URL, FACEBOOK_URL, CONTACT_EMAIL } from "../consts";
---

<Page
	title="Contact us"
	description="Get in touch with Aequus Archers."
	intro="Questions about sessions, membership or anything else? Drop us a message."
>
	<section class="contact">
		<form class="contact-form panel" action="/api/contact" method="POST">
			<p class="form-error" id="form-error" hidden>
				Sorry, something went wrong sending your message. Please try again, or reach us on social
				media.
			</p>

			<input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" style="display:none" />

			<label>
				<span>Your name</span>
				<input type="text" name="name" required />
			</label>
			<label>
				<span>Email</span>
				<input type="email" name="email" required />
			</label>
			<label>
				<span>Message</span>
				<textarea name="message" rows="5" required></textarea>
			</label>
			<button type="submit" class="btn">Send message</button>
			<p class="privacy">
				We'll only use your details to reply to your message. See our <a href="/policies#privacy"
					>privacy policy</a
				>.
			</p>
		</form>

		<aside class="contact-side">
			<h3>Prefer another way?</h3>
			<p>Email us at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>, or send a message on social media.</p>
			<div class="links">
				<a href={INSTAGRAM_URL} target="_blank" rel="noopener">Instagram</a>
				<a href={FACEBOOK_URL} target="_blank" rel="noopener">Facebook</a>
			</div>
		</aside>
	</section>

	<script>
		if (new URLSearchParams(window.location.search).get("error")) {
			const el = document.getElementById("form-error");
			if (el) el.hidden = false;
		}
	</script>

	<style>
		.contact {
			display: grid;
			grid-template-columns: 1.4fr 1fr;
			gap: 40px;
			align-items: start;
		}
		.contact-form {
			border-radius: var(--radius-l);
			padding: 32px;
		}
		.contact-form label {
			display: block;
			margin-bottom: 18px;
		}
		.contact-form label span {
			display: block;
			font-weight: 700;
			margin-bottom: 6px;
		}
		.contact-form input,
		.contact-form textarea {
			width: 100%;
			padding: 12px 16px;
			border: 1.5px solid var(--line);
			border-radius: var(--radius-s);
			font: inherit;
			font-size: 1rem;
			background: var(--paper);
			color: var(--ink);
		}
		.contact-form input:focus,
		.contact-form textarea:focus {
			outline: none;
			border-color: var(--pine-mid);
			box-shadow: 0 0 0 4px var(--pine-soft);
			background: #fff;
		}
		.contact-form textarea {
			resize: vertical;
		}
		.form-error {
			background: var(--coral-soft);
			color: var(--coral-deep);
			border-radius: var(--radius-s);
			padding: 12px 16px;
			font-size: 1rem;
			margin: 0 0 18px;
		}
		.privacy {
			font-size: 0.95rem;
			color: var(--muted);
			margin: 16px 0 0;
		}
		.contact-side {
			background: var(--pine-soft);
			border-radius: var(--radius-l);
			padding: 28px;
		}
		.contact-side .links {
			display: flex;
			flex-wrap: wrap;
			gap: 10px;
			margin-top: 14px;
		}
		.contact-side .links a {
			display: inline-block;
			background: var(--card);
			color: var(--pine);
			font-weight: 700;
			text-decoration: none;
			padding: 10px 18px;
			border-radius: 999px;
		}
		.contact-side .links a:hover {
			background: var(--butter);
		}
		@media (max-width: 760px) {
			.contact {
				grid-template-columns: 1fr;
			}
			.contact-form {
				padding: 24px 20px;
			}
		}
	</style>
</Page>
