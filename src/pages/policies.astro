---
import Page from "../layouts/Page.astro";

const policies = [
	{
		id: "safeguarding",
		title: "Safeguarding policy",
		blurb:
			"How we keep children, young people and adults at risk safe at the club, and who to contact with a concern.",
	},
	{
		id: "privacy",
		title: "Privacy policy",
		blurb: "What personal data we collect, why we collect it, and how we look after it.",
	},
	{
		id: "charter",
		title: "Club charter",
		blurb: "Our values, code of conduct, and what members can expect from the club and each other.",
	},
];
---

<Page
	title="Policies"
	description="Aequus Archers' safeguarding, privacy and club charter documents."
	intro="Our club policies. Full documents will be published here soon."
>
	{
		policies.map((p) => (
			<section id={p.id}>
				<h2>{p.title}</h2>
				<p>{p.blurb}</p>
				<a class="btn" href="#">Read the policy (coming soon)</a>
			</section>
		))
	}
	<section>
		<div class="note">
			To publish a policy, drop the PDF into <code>public/policies/</code> and point the button's
			<code>href</code> at it (e.g. <code>/policies/safeguarding.pdf</code>), or replace the button
			with the policy text.
		</div>
	</section>
</Page>
