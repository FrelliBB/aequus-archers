---
import { getCollection } from "astro:content";
import Page from "../layouts/Page.astro";

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const policies = (await getCollection("policies"))
	.map((p) => p.data)
	.sort((a, b) => a.order - b.order)
	.map((p) => ({ ...p, anchor: p.anchor ?? slug(p.title) }));
---

<Page
	title="Policies"
	description="Aequus Archers' safeguarding, privacy and club charter documents."
	intro="Our club policies. Full documents will be published here soon."
>
	{
		policies.map((p) => (
			<section id={p.anchor}>
				<h2>{p.title}</h2>
				<p>{p.summary}</p>
				{p.document ? (
					<a class="btn" href={p.document}>Read the policy</a>
				) : (
					<p class="muted">Full document coming soon.</p>
				)}
			</section>
		))
	}
</Page>
