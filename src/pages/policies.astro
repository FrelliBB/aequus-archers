---
import Page from "../layouts/Page.astro";

const policies: { id: string; title: string; blurb: string; href?: string }[] = [
	{
		id: "safeguarding",
		title: "Safeguarding policy",
		blurb:
			"How we keep children, young people and adults at risk safe at the club, and who to contact with a concern.",
	},
	{
		id: "privacy",
		title: "Privacy policy",
		blurb: "What personal data we collect, why we collect it, and how we look after it.",
	},
	{
		id: "charter",
		title: "Club charter",
		blurb: "Our values, code of conduct, and what members can expect from the club and each other.",
	},
];
---

<Page
	title="Policies"
	description="Aequus Archers' safeguarding, privacy and club charter documents."
	intro="Our club policies. Full documents will be published here soon."
>
	{
		policies.map((p) => (
			<section id={p.id}>
				<h2>{p.title}</h2>
				<p>{p.blurb}</p>
				{p.href ? (
					<a class="btn" href={p.href}>Read the policy</a>
				) : (
					<p class="muted">Full document coming soon.</p>
				)}
			</section>
		))
	}
</Page>
