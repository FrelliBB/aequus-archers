---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Figure from "../components/Figure.astro";
import { SITE_TITLE, SITE_DESCRIPTION, BOOK_URL } from "../consts";

const heroImg = "/images/hero.jpg";
const logoImg = "/images/logo.png";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} | Archery club in Derbyshire`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="aeq">
			<section class="hero">
				<div class="hero-inner">
					<div class="hero-copy">
						<img class="hero-logo" src={logoImg} alt="Aequus Archers logo" width="120" height="84" />
						<h1>Aequus Archers</h1>
						<p class="latin">Aequus <span>·</span> even, calm, equal, favourable, just, fair</p>
						<p class="hero-lede">
							A friendly, volunteer-run target archery club in Milford, Derbyshire — welcoming
							archers of every age and ability since 2012.
						</p>
						<div class="hero-cta">
							<a class="btn" href="/sessions">Try archery</a>
							<a class="btn ghost" href="#get-involved">Ways to get involved</a>
						</div>
					</div>
					<div class="hero-media">
						<img src={heroImg} alt="Archers shooting at the Aequus Archers field" loading="eager" />
					</div>
				</div>
			</section>

			<div class="wrap">
				<section class="who">
					<div class="who-text has-figure">
						<Figure
							src="/images/community/club-day.jpg"
							alt="Aequus Archers members together on a club day"
							caption="A club day on the field — the heart of the club is its people."
							align="right"
						/>
						<h2 class="sechead">Who we are</h2>
						<p>
							Founded in 2012 by a passionate group of coaches, Aequus Archers exists to promote
							archery as a sport for everyone — irrespective of age, gender, ethnicity, background
							or circumstance.
						</p>
						<p>
							Whether you’re curious to try something new, looking for a deeper introduction through
							a beginner’s course, or ready to join as a member, we offer a welcoming pathway into
							the world of archery.
						</p>
						<p class="values">
							Our name says it all — <em>aequus</em> is Latin for even, calm, equal, favourable,
							just and fair, and that's the spirit we bring to every session.
						</p>
					</div>
				</section>

				<section id="get-involved" class="involve">
					<h2 class="sechead">Ways to get involved</h2>
					<p class="lede">Three simple ways in — start wherever feels right.</p>
					<div class="cards">
						<div class="card">
							<span class="step">1</span>
							<h3>Try a taster</h3>
							<p>
								A one-off 1.5-hour session to give archery a go. All equipment provided, no
								experience needed.
							</p>
							<p class="price">£15 · £10 under-16</p>
							<a class="cardlink" href="/sessions">See taster dates →</a>
						</div>
						<div class="card">
							<span class="step">2</span>
							<h3>Beginner’s course</h3>
							<p>
								Four weekend sessions to learn the fundamentals and earn the Archery GB
								certificate needed to join a club.
							</p>
							<p class="price">£90 · £45 under-18</p>
							<a class="cardlink" href="/sessions">See course dates →</a>
						</div>
						<div class="card">
							<span class="step">3</span>
							<h3>Become a member</h3>
							<p>
								Completed a course? Join Aequus Archers and shoot with us regularly throughout the
								season.
							</p>
							<p class="price">Members welcome</p>
							<a class="cardlink" href="/about#membership">How to join →</a>
						</div>
					</div>
				</section>

				<Figure
					src="/images/community/taster-smiles.jpg"
					alt="Beginners smiling during an Aequus Archers taster session"
					caption="Beginners on the line at a taster session — all kit provided, no experience needed."
					align="full"
					ratio="12 / 5"
				/>

				<div class="outro">
					<h2>Ready to give it a go?</h2>
					<p>Pick a taster or course date and reserve your place — beginners always welcome.</p>
					<a class="btn big" href="/sessions">View upcoming sessions</a>
				</div>
			</div>
		</main>
		<Footer />

		<style>
			.hero {
				background: var(--aeq-primary);
				color: #fff;
			}
			.hero-inner {
				max-width: 1040px;
				margin: 0 auto;
				padding: 48px 20px;
				display: grid;
				grid-template-columns: 1.1fr 0.9fr;
				gap: 36px;
				align-items: center;
			}
			.hero-logo {
				display: inline-block;
				margin-bottom: 16px;
				height: 60px;
				width: auto;
				background: #fff;
				padding: 10px 14px;
				border-radius: 12px;
			}
			.hero-copy h1 {
				font-size: clamp(2.25rem, 5vw, 3.25rem);
				line-height: 1.05;
				margin: 0 0 10px;
				color: #fff;
				font-weight: 700;
			}
			.latin {
				font-family: var(--aeq-font-display);
				font-style: italic;
				font-size: 1.0625rem;
				color: var(--aeq-accent-soft);
				margin: 0 0 16px;
			}
			.latin span {
				opacity: 0.6;
				margin: 0 6px;
			}
			.hero-lede {
				font-size: 1.125rem;
				line-height: 1.6;
				opacity: 0.95;
				max-width: 46ch;
				margin: 0 0 24px;
			}
			.hero-cta {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
			}
			.hero-media img {
				width: 100%;
				border-radius: 16px;
				display: block;
				aspect-ratio: 3 / 2;
				object-fit: cover;
			}
			.btn {
				display: inline-block;
				background: var(--aeq-accent);
				color: #fff;
				font-weight: 700;
				font-size: 1.0625rem;
				text-decoration: none;
				padding: 13px 24px;
				border-radius: 999px;
			}
			.btn:hover {
				filter: brightness(1.05);
			}
			.btn.big {
				font-size: 1.125rem;
				padding: 14px 30px;
			}
			.btn.ghost {
				background: transparent;
				color: #fff;
				border: 2px solid rgba(255, 255, 255, 0.55);
			}
			.wrap {
				max-width: 1040px;
				margin: 0 auto;
				padding: 44px 20px;
			}
			.sechead {
				font-size: 1.75rem;
				font-weight: 700;
				color: var(--aeq-primary-dark);
				margin: 0 0 10px;
			}
			.lede {
				font-size: 1.0625rem;
				color: var(--aeq-muted);
				max-width: 560px;
				margin: 0 0 20px;
			}
			.who p {
				font-size: 1.0625rem;
				color: var(--aeq-ink);
				max-width: 70ch;
				margin: 0 0 14px;
			}
			.values {
				margin: 18px 0 0;
				clear: both;
				color: var(--aeq-muted);
				font-size: 1.0625rem;
				max-width: 60ch;
			}
			.involve {
				margin-top: 56px;
			}
			.cards {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				gap: 32px;
				margin-top: 26px;
			}
			.card {
				display: flex;
				flex-direction: column;
				border-top: 2px solid var(--aeq-line);
				padding-top: 18px;
			}
			.card .step {
				font-family: var(--aeq-font-display);
				font-size: 2.375rem;
				line-height: 1;
				color: var(--aeq-accent);
				margin-bottom: 10px;
			}
			.card h3 {
				font-size: 1.25rem;
				font-weight: 700;
				color: var(--aeq-primary-dark);
				margin: 0 0 6px;
			}
			.card p {
				font-size: 1rem;
				color: var(--aeq-muted);
				margin: 0 0 12px;
			}
			.card .price {
				font-weight: 700;
				color: var(--aeq-accent-text);
				font-size: 1rem;
			}
			.cardlink {
				display: inline-block;
				margin-top: auto;
				font-weight: 700;
				font-size: 1.0625rem;
				color: var(--aeq-accent-text);
				text-decoration: none;
				padding: 8px 0;
			}
			.cardlink:hover {
				text-decoration: underline;
			}
			.outro {
				text-align: center;
				margin-top: 56px;
				padding-top: 40px;
				border-top: 2px solid var(--aeq-line);
			}
			.outro h2 {
				margin: 0 0 6px;
				font-size: 1.75rem;
				font-weight: 700;
				color: var(--aeq-primary-dark);
			}
			.outro p {
				margin: 0 auto 20px;
				color: var(--aeq-muted);
				font-size: 1.0625rem;
				max-width: 50ch;
			}
			@media (max-width: 760px) {
				.hero-inner {
					grid-template-columns: 1fr;
					gap: 24px;
				}
			}
		</style>
	</body>
</html>
