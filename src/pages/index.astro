---
import Base from "../layouts/Base.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { TASTERS, parseDate, fmt } from "../data/sessions";
import { Image } from "astro:assets";
import { photo } from "../lib/images";

const today = new Date();
today.setHours(0, 0, 0, 0);
const next = TASTERS.map((t) => ({ ...t, d: parseDate(t.date) }))
	.filter((t) => t.d >= today)
	.sort((a, b) => a.d.getTime() - b.d.getTime())[0];
---

<Base title={`${SITE_TITLE} | Archery club in Derbyshire`} description={SITE_DESCRIPTION}>
	<section class="hero wrap">
		<div class="copy">
			<p class="kicker">Target archery in Milford, Derbyshire</p>
			<h1>Come and have a <em>go</em>.</h1>
			<p class="lede">
				We’re a friendly, volunteer-run club. Beginners of every age are welcome, and we lend you
				all the kit.
			</p>
			<div class="actions">
				<a class="btn btn--big" href="/sessions">Book a taster</a>
				<a class="btn btn--ghost btn--big" href="#get-involved">How it works</a>
			</div>
			<ul class="pills facts">
				<li>All kit provided</li>
				<li>Ages 8 and up</li>
				<li>Shooting since 2012</li>
			</ul>
		</div>
		<div class="media">
			<Image
				class="photo photo--offset"
				src={photo("hero.jpg")}
				alt="A club member drawing a compound bow on the field at Milford"
				widths={[640, 960, 1280, 1600]}
				sizes="(max-width: 860px) 100vw, 510px"
				loading="eager"
				fetchpriority="high"
			/>
			<a class="next" href="/sessions">
				{
					next ? (
						<>
							<span class="label">Next taster</span>
							<span class="when">
								{fmt(next.d, { weekday: "short", day: "numeric", month: "short" })} · {next.time}
							</span>
						</>
					) : (
						<>
							<span class="label">New dates soon</span>
							<span class="when">See what’s coming up</span>
						</>
					)
				}
			</a>
		</div>
	</section>

	<section class="who wrap">
		<div class="meaning" aria-label="The meaning of aequus">
			<p class="word">aequus</p>
			<p class="def">
				<span>Latin, adjective.</span> Even, calm, equal, favourable, just, fair.
			</p>
		</div>
		<div class="text">
			<h2>A club for everyone</h2>
			<p>
				A group of coaches started Aequus Archers in 2012 to make archery a sport for everyone,
				whatever your age, gender, ethnicity, background or circumstance.
			</p>
			<p>
				Some of us come for the quiet focus, some for the competition, and most of us stay for the
				people. Our name is the spirit we try to bring to every session.
			</p>
			<a class="textlink" href="/about">More about the club</a>
		</div>
	</section>

	<section id="get-involved" class="involve">
		<div class="wrap">
			<h2>Three ways in</h2>
			<p class="lede">Start wherever feels right. Most people begin with a taster.</p>
			<ol class="steps">
				<li class="step s1">
					<span class="num">1</span>
					<h3>Try a taster</h3>
					<p>A one-off 1.5-hour session to give archery a go. No experience needed.</p>
					<p class="price">£15 · £10 under-16</p>
					<a class="textlink" href="/sessions">Taster dates</a>
				</li>
				<li class="step s2">
					<span class="num">2</span>
					<h3>Beginner’s course</h3>
					<p>
						Four weekend sessions to learn the basics and earn the Archery GB certificate you need
						to join a club.
					</p>
					<p class="price">£90 · £45 under-18</p>
					<a class="textlink" href="/sessions">Course dates</a>
				</li>
				<li class="step s3">
					<span class="num">3</span>
					<h3>Join the club</h3>
					<p>Finished a course? Become a member and shoot with us through the season.</p>
					<p class="price">Members welcome</p>
					<a class="textlink" href="/about#membership">How to join</a>
				</li>
			</ol>
		</div>
	</section>

	<section class="gallery wrap" aria-label="Club photos">
		<figure class="g1">
			<Image
				class="photo"
				src={photo("community/taster-smiles.jpg")}
				alt="Beginners smiling during a taster session"
				widths={[640, 960, 1200]}
				sizes="(max-width: 860px) 100vw, 600px"
			/>
			<figcaption>Beginners on the line at a taster session.</figcaption>
		</figure>
		<figure class="g2">
			<Image
				class="photo photo--offset-sage"
				src={photo("community/club-day.jpg")}
				alt="Members together on a club day"
				widths={[480, 800]}
				sizes="(max-width: 860px) 100vw, 400px"
			/>
			<figcaption>A club day on the field.</figcaption>
		</figure>
	</section>

	<section class="wrap">
		<div class="outro">
			<h2>Ready to give it a go?</h2>
			<p>Pick a taster or course date and save your place. Beginners are always welcome.</p>
			<a class="btn btn--big" href="/sessions">See upcoming sessions</a>
		</div>
	</section>
</Base>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 56px;
		align-items: center;
		padding-top: 56px;
		padding-bottom: 72px;
	}
	.hero h1 {
		font-size: clamp(2.75rem, 7vw, 4.75rem);
		margin-bottom: 18px;
	}
	.hero .lede {
		margin-bottom: 28px;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.facts {
		margin-top: 28px;
	}
	.media {
		position: relative;
		margin-right: 14px;
	}
	.media .photo {
		aspect-ratio: 4 / 3.4;
		object-position: 30% center;
	}
	.next {
		position: absolute;
		left: -28px;
		bottom: -26px;
		display: flex;
		flex-direction: column;
		background: var(--card);
		color: var(--pine);
		text-decoration: none;
		padding: 14px 20px;
		border-radius: var(--radius);
		box-shadow: 0 10px 30px rgba(31, 59, 48, 0.16);
	}
	.next .label {
		font-family: var(--font-display);
		font-style: italic;
		color: var(--coral-deep);
		font-size: 0.95rem;
	}
	.next .when {
		font-weight: 700;
		font-size: 1.125rem;
	}
	.next:hover {
		transform: translateY(-2px);
	}

	.who {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 56px;
		align-items: start;
		padding-top: 48px;
		padding-bottom: 88px;
	}
	.meaning {
		border-left: 4px solid var(--butter);
		padding: 4px 0 4px 26px;
	}
	.word {
		font-family: var(--font-display);
		font-variation-settings: "SOFT" 100, "WONK" 1;
		font-style: italic;
		font-size: clamp(3rem, 7vw, 5rem);
		line-height: 1;
		color: var(--pine);
		margin: 0 0 12px;
	}
	.def {
		font-size: 1.2rem;
		color: var(--pine);
		max-width: 26ch;
	}
	.def span {
		font-family: var(--font-display);
		font-style: italic;
		color: var(--muted);
	}
	.text p {
		max-width: 58ch;
	}

	.involve {
		background: var(--pine-soft);
		border-radius: var(--radius-l);
		margin: 0 12px;
		padding: 72px 0 88px;
	}
	.steps {
		list-style: none;
		padding: 0;
		margin: 36px 0 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
		align-items: start;
	}
	.step {
		background: var(--card);
		border-radius: var(--radius);
		padding: 26px 26px 22px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}
	.s2 {
		margin-top: 32px;
	}
	.s3 {
		margin-top: 64px;
	}
	.num {
		font-family: var(--font-display);
		font-style: italic;
		font-size: 3rem;
		line-height: 1;
		margin-bottom: 12px;
		width: 64px;
		height: 64px;
		display: grid;
		place-items: center;
		border-radius: 50%;
	}
	.s1 .num {
		background: var(--butter);
	}
	.s2 .num {
		background: var(--coral-soft);
	}
	.s3 .num {
		background: var(--pine-soft);
	}
	.step p {
		font-size: 1rem;
		color: var(--muted);
		margin-bottom: 10px;
	}
	.step .price {
		font-weight: 700;
		color: var(--pine);
		margin-bottom: 14px;
	}

	.gallery {
		display: grid;
		grid-template-columns: 1.5fr 1fr;
		gap: 40px;
		align-items: start;
		padding-top: 88px;
		padding-bottom: 40px;
	}
	.gallery figure {
		margin: 0;
	}
	.gallery .g1 .photo {
		aspect-ratio: 3 / 2;
	}
	.gallery .g2 {
		margin-top: 72px;
		margin-left: 14px;
	}
	.gallery .g2 .photo {
		aspect-ratio: 4 / 5;
	}
	.gallery figcaption {
		font-family: var(--font-display);
		font-style: italic;
		color: var(--muted);
		font-size: 1rem;
		margin-top: 18px;
	}

	.outro {
		background: var(--butter-soft);
		border-radius: var(--radius-l);
		padding: 56px 32px;
		text-align: center;
		margin-top: 48px;
	}
	.outro p {
		max-width: 44ch;
		margin: 0 auto 26px;
	}

	@media (max-width: 860px) {
		.hero,
		.who {
			grid-template-columns: 1fr;
			gap: 40px;
		}
		.hero {
			padding-top: 32px;
		}
		.media {
			margin-bottom: 20px;
		}
		.next {
			left: 14px;
		}
		.steps {
			grid-template-columns: 1fr;
		}
		.s2,
		.s3 {
			margin-top: 0;
		}
		.involve {
			margin: 0;
			padding: 56px 0 64px;
		}
		.gallery {
			grid-template-columns: 1fr;
		}
		.gallery .g2 {
			margin-top: 0;
			margin-right: 14px;
		}
	}
</style>
