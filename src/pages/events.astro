---
import Page from "../layouts/Page.astro";
---

<Page
	title="Events calendar"
	description="Upcoming sessions, shoots and club events at Aequus Archers."
	intro="Club shoots, social events and session dates — all in one place. Calendar coming soon."
>
	<section>
		<h2>What you’ll find here</h2>
		<p>
			Once it’s live, this page will list upcoming club shoots, competitions, work parties and
			social events, alongside taster and beginner-course dates.
		</p>
		<a class="btn" href="/sessions">See upcoming sessions</a>
	</section>
	<section>
		<div class="note">
			Options for the calendar: embed your Spond group calendar, embed a Google Calendar, or render
			events from a data file the same way the sessions page does. Edit <code
				>src/pages/events.astro</code
			> when you’re ready.
		</div>
	</section>
</Page>
