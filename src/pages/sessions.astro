---
import Base from "../layouts/Base.astro";
import { SITE_TITLE, BOOK_URL } from "../consts";
import { getCollection } from "astro:content";
import { parseDate, fmt, startOfToday } from "../lib/dates";

const buildToday = startOfToday();
const isPast = (d: Date) => d.getTime() < buildToday.getTime();

const tasters = (await getCollection("tasters"))
	.map(({ data: t }) => ({ ...t, d: parseDate(t.date) }))
	.sort((a, b) => a.d.getTime() - b.d.getTime());

const courses = (await getCollection("courses")).map(({ data: c }) => {
	const isoSorted = [...c.dates].sort();
	return { ...c, ds: isoSorted.map(parseDate), startISO: isoSorted[0] };
}).sort((a, b) => (a.startISO < b.startISO ? -1 : 1));

const nextT = tasters.find((t) => !isPast(t.d));
const nextC = courses.find((c) => !isPast(c.ds[0]));
const season = (nextT?.d ?? nextC?.ds[0] ?? buildToday).getFullYear();
function relTag(d: Date) {
	const days = Math.round((d.getTime() - buildToday.getTime()) / 86400000);
	if (days === 0) return "Today";
	if (days === 1) return "Tomorrow";
	if (days <= 7) return "This " + fmt(d, { weekday: "long" });
	return "Coming up";
}

const pageTitle = `Try archery | ${SITE_TITLE}`;
const pageDesc =
	"Book a taster session or a beginner's course with Aequus Archers in Milford, Derbyshire. All equipment provided, beginners welcome.";
---

<Base title={pageTitle} description={pageDesc}>
	<div class="wrap sessions">
		<p class="kicker">{season} season · now booking</p>
		<h1>Upcoming sessions</h1>
		<p class="lede">
			Come and have a go. All equipment provided, total beginners welcome — just pick a date and
			reserve your place.
		</p>
		<ul class="pills facts">
			<li>All kit provided</li>
			<li>Beginners welcome</li>
			<li>Ages 8+ (110&nbsp;cm+)</li>
			<li>Milford, Derbyshire</li>
		</ul>

		{
			nextT && (
				<div class="next" id="next-banner">
					<div class="cal">
						<div class="d">{nextT.d.getDate()}</div>
						<div class="m">{fmt(nextT.d, { month: "short" })}</div>
					</div>
					<div>
						<span class="tag">{relTag(nextT.d)}</span>
						<h2>Next taster session</h2>
						<p>
							{fmt(nextT.d, { weekday: "long", day: "numeric", month: "long" })} · {nextT.time} ·
							1.5 hrs · £15 (£10 under-16)
						</p>
					</div>
					<a class="btn btn--butter" href={BOOK_URL}>Reserve a place</a>
				</div>
			)
		}

		<div class="grouphead">
			<h2>Taster sessions</h2><span class="price">£15 · £10 under-16</span>
		</div>
		<p class="groupsub">
			A one-off 1.5-hour session — perfect to try archery and see if it’s for you.
		</p>
		<div class="taster-grid">
			{
				tasters.map((t) => (
					<div class="tcard" data-date={t.date} data-time={t.time} hidden={isPast(t.d)}>
						<div class="body">
							<div class="day">{fmt(t.d, { weekday: "long" })}</div>
							<div class="date">{fmt(t.d, { day: "numeric", month: "short" })}</div>
							<div class="time">{t.time}</div>
							<div class="meta">1.5 hrs · kit provided</div>
							{t.note && <div class="tnote">{t.note}</div>}
							<span class="soontag" hidden>
								Next up
							</span>
							<div class="foot">
								<a href={BOOK_URL}>
									Reserve <span class="arrow">→</span>
								</a>
							</div>
						</div>
					</div>
				))
			}
		</div>
		<div class="empty" id="taster-empty" hidden>
			More taster dates coming soon — join the waiting list and we’ll let you know.
		</div>

		<div class="gap"></div>
		<div class="grouphead">
			<h2>Beginner courses</h2><span class="price">£90 · £45 under-18</span>
		</div>
		<p class="groupsub">
			Four 3-hour sessions, or two full days over one weekend. Learn the fundamentals, then earn
			your certificate — required to join any Archery GB club, including ours.
		</p>
		<div class="course-grid">
			{
				courses.map((c) => (
					<div class="ccard" data-start={c.startISO} hidden={isPast(c.ds[0])}>
						<span class="ctag">{c.ds.length === 2 ? "Weekend course" : `${c.ds.length} sessions`}</span>
						<h3>{c.name}</h3>
						<p class="sub">{c.times}</p>
						<ul class="dates">
							{c.ds.map((d, i) => (
								<li>
									<span class="pin">{i + 1}</span>{" "}
									{fmt(d, { weekday: "short", day: "numeric", month: "long" })}
								</li>
							))}
						</ul>
						{c.note && <p class="cnote">{c.note}</p>}
						<p class="perks">Certificate on completion · all sessions required · kit provided</p>
						<div class="priceline">
							<span class="big">£90</span> <span class="small">/ £45 under-18</span>
						</div>
						<a class="btn" href={BOOK_URL}>
							Join the {c.name}
						</a>
					</div>
				))
			}
		</div>
		<div class="empty" id="course-empty" hidden>
			Our next beginner course dates are being finalised — join the waiting list to hear first.
		</div>

		<div class="gap"></div>
		<h2>Session information</h2>
		<p class="lede">
			Book a taster session or a beginner course and discover this exciting sport with us.
		</p>
		<ul class="info-list">
			<li><strong>Where</strong> — our outdoor field in Milford, Derbyshire</li>
			<li><strong>When</strong> — throughout the summer season</li>
			<li><strong>How often</strong> — one taster a month · three courses a year</li>
		</ul>
		<p class="info-copy">
			Every session is led by an experienced archer, and all equipment is provided. We welcome
			participants of all ages and abilities — children must be at least 110&nbsp;cm tall to
			take part.
		</p>
		<div class="two-up">
			<div class="mini">
				<h4>Taster sessions — £15</h4>
				<p>
					A one-off 1.5-hour session that’s perfect if you’d like to try archery and see if
					it’s for you.
				</p>
			</div>
			<div class="mini">
				<h4>Beginner courses — £90 (£45 under-18)</h4>
				<p>
					A four-week course over consecutive weekends (3 hrs each). Finish all four to
					receive your certificate — required to join any Archery GB-affiliated club,
					including Aequus Archers.
				</p>
			</div>
		</div>

		<div class="gap"></div>
		<h2>How to prepare</h2>
		<p class="lede">A few things to help you enjoy your session safely and comfortably.</p>
		<ul class="prep-list">
			<li>Juniors (under 18) must be accompanied by a parent or guardian for the whole session.</li>
			<li>Let us know about any medical conditions or special needs that could affect taking part.</li>
			<li>
				Bring any essential medication, enough food and drink, and weather-appropriate clothing
				(and sunscreen on sunny days).
			</li>
			<li>Tie long hair back — clips or bobbles work well.</li>
			<li>
				Footwear: no open-toed shoes, sandals or flip-flops. Grass can be wet, so wear something
				suitable.
			</li>
			<li>Avoid loose clothing or drawstrings (like hoodies) — they can catch in the bow string.</li>
			<li>Facial piercings may need to be removed for safety.</li>
		</ul>

		<div class="outro">
			<h2>Ready to give it a go?</h2>
			<p>Pick a date above, then join the waiting list and we’ll be in touch.</p>
			<a class="btn btn--big" href={BOOK_URL}>Join the waiting list</a>
		</div>
	</div>

	<script>
		const today = new Date();
		today.setHours(0, 0, 0, 0);
		const L = "en-GB";
		const f = (d: Date, o: Intl.DateTimeFormatOptions) =>
			new Intl.DateTimeFormat(L, o).format(d);
		const parse = (s: string) => new Date(s + "T00:00:00");

		const tcards = Array.from(
			document.querySelectorAll<HTMLElement>(".tcard[data-date]"),
		);
		let firstVisible: HTMLElement | null = null;
		tcards.forEach((c) => {
			const tag = c.querySelector<HTMLElement>(".soontag");
			if (tag) tag.hidden = true;
			const d = parse(c.dataset.date!);
			if (d < today) {
				c.hidden = true;
			} else if (!firstVisible) {
				firstVisible = c;
			}
		});

		const tEmpty = document.getElementById("taster-empty");
		const banner = document.getElementById("next-banner");
		if (firstVisible) {
			const card = firstVisible as HTMLElement;
			if (tEmpty) tEmpty.hidden = true;
			const tag = card.querySelector<HTMLElement>(".soontag");
			if (tag) tag.hidden = false;
			if (banner) {
				const d = parse(card.dataset.date!);
				const time = card.dataset.time!;
				const days = Math.round((d.getTime() - today.getTime()) / 86400000);
				const rel =
					days === 0
						? "Today"
						: days === 1
							? "Tomorrow"
							: days <= 7
								? "This " + f(d, { weekday: "long" })
								: "Coming up";
				banner.querySelector(".d")!.textContent = String(d.getDate());
				banner.querySelector(".m")!.textContent = f(d, { month: "short" });
				banner.querySelector(".tag")!.textContent = rel;
				banner.querySelector("p")!.textContent =
					f(d, { weekday: "long", day: "numeric", month: "long" }) +
					" · " +
					time +
					" · 1.5 hrs · £15 (£10 under-16)";
				banner.hidden = false;
			}
		} else {
			if (tEmpty) tEmpty.hidden = false;
			if (banner) banner.hidden = true;
		}

		let anyCourse = false;
		document
			.querySelectorAll<HTMLElement>(".ccard[data-start]")
			.forEach((c) => {
				if (parse(c.dataset.start!) < today) c.hidden = true;
				else anyCourse = true;
			});
		const cEmpty = document.getElementById("course-empty");
		if (cEmpty) cEmpty.hidden = anyCourse;
	</script>
</Base>

<style>
	[hidden] {
		display: none !important;
	}
	.sessions {
		padding-top: 56px;
	}
	.sessions h1 {
		margin-bottom: 14px;
	}
	.facts {
		margin: 22px 0 40px;
	}
	.gap {
		margin-top: 72px;
	}

	.next {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 20px 24px;
		background: var(--pine);
		color: var(--pine-soft);
		border-radius: var(--radius-l);
		padding: 26px 30px;
		margin-bottom: 64px;
	}
	.next .cal {
		background: var(--butter);
		color: var(--pine);
		border-radius: var(--radius);
		padding: 10px 16px;
		text-align: center;
		min-width: 80px;
	}
	.next .cal .d {
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 600;
		line-height: 1;
	}
	.next .cal .m {
		font-size: 0.95rem;
		font-weight: 700;
		margin-top: 4px;
	}
	.next .tag {
		font-family: var(--font-display);
		font-style: italic;
		color: var(--butter);
		font-size: 1rem;
	}
	.next h2 {
		margin: 2px 0;
		font-size: 1.5rem;
		color: var(--paper);
	}
	.next p {
		margin: 0;
		font-size: 1rem;
	}
	.next .btn {
		margin-left: auto;
	}

	.grouphead {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 16px;
	}
	.grouphead h2 {
		margin: 0;
	}
	.grouphead .price {
		font-weight: 700;
		color: var(--coral-deep);
	}
	.groupsub {
		color: var(--muted);
		margin: 6px 0 22px;
		max-width: 60ch;
	}

	.taster-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
		gap: 16px;
	}
	.tcard {
		background: var(--card);
		border-radius: var(--radius);
		display: flex;
		flex-direction: column;
	}
	.tcard:nth-child(3n + 1) {
		border-top: 6px solid var(--butter);
	}
	.tcard:nth-child(3n + 2) {
		border-top: 6px solid var(--sage);
	}
	.tcard:nth-child(3n + 3) {
		border-top: 6px solid var(--coral);
	}
	.tcard .body {
		padding: 18px 20px 14px;
		display: flex;
		flex-direction: column;
		flex: 1;
	}
	.tcard .day {
		font-family: var(--font-display);
		font-style: italic;
		color: var(--muted);
	}
	.tcard .date {
		font-family: var(--font-display);
		font-variation-settings: "SOFT" 100, "WONK" 1;
		font-size: 1.75rem;
		font-weight: 600;
		line-height: 1.1;
	}
	.tcard .time {
		font-weight: 700;
		margin-top: 4px;
	}
	.tcard .meta {
		font-size: 0.95rem;
		color: var(--muted);
	}
	.tcard .tnote {
		font-family: var(--font-display);
		font-style: italic;
		color: var(--coral-deep);
		margin-top: 4px;
	}
	.tcard .soontag {
		align-self: flex-start;
		background: var(--coral-soft);
		color: var(--coral-deep);
		font-weight: 700;
		font-size: 0.85rem;
		padding: 3px 12px;
		border-radius: 999px;
		margin-top: 10px;
	}
	.tcard .foot {
		margin-top: auto;
		padding-top: 12px;
	}
	.tcard .foot a {
		display: inline-block;
		font-weight: 700;
		color: var(--pine);
		text-decoration: none;
		padding: 8px 0;
	}
	.tcard .foot a .arrow {
		color: var(--coral);
	}
	.tcard .foot a:hover {
		color: var(--coral-deep);
	}

	.course-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 24px;
	}
	.ccard {
		background: var(--card);
		border-radius: var(--radius-l);
		padding: 28px;
	}
	.ctag {
		display: inline-block;
		background: var(--pine-soft);
		font-weight: 700;
		font-size: 0.85rem;
		padding: 3px 12px;
		border-radius: 999px;
	}
	.ccard h3 {
		font-size: 1.6rem;
		margin: 12px 0 2px;
	}
	.ccard .sub {
		color: var(--muted);
		margin: 0 0 16px;
	}
	.dates {
		list-style: none;
		padding: 0;
		margin: 0 0 18px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.dates li {
		display: flex;
		align-items: center;
		gap: 12px;
		font-weight: 600;
	}
	.dates .pin {
		flex: 0 0 auto;
		width: 28px;
		height: 28px;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: var(--butter-soft);
		font-family: var(--font-display);
		font-style: italic;
		font-size: 0.95rem;
	}
	.cnote {
		background: var(--butter-soft);
		border-radius: var(--radius-s);
		padding: 8px 12px;
		font-size: 0.95rem;
		margin: 0 0 14px;
	}
	.perks {
		font-size: 0.95rem;
		color: var(--muted);
		border-top: 1px dashed var(--line);
		padding-top: 14px;
		margin: 0 0 14px;
	}
	.priceline {
		margin-bottom: 18px;
	}
	.priceline .big {
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 600;
	}
	.priceline .small {
		color: var(--muted);
	}
	.empty {
		background: var(--butter-soft);
		border-radius: var(--radius);
		padding: 16px 20px;
		max-width: 60ch;
	}

	.info-list {
		list-style: none;
		padding: 0;
		margin: 0 0 16px;
	}
	.info-list li {
		margin-bottom: 6px;
	}
	.info-copy {
		max-width: 68ch;
	}
	.two-up {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 20px;
		margin-top: 24px;
	}
	.mini {
		border-radius: var(--radius);
		padding: 22px 24px;
		background: var(--pine-soft);
	}
	.mini + .mini {
		background: var(--butter-soft);
	}
	.mini h4 {
		margin: 0 0 6px;
		font-size: 1.2rem;
	}
	.mini p {
		margin: 0;
		font-size: 1rem;
	}

	.prep-list {
		list-style: none;
		padding: 0;
		margin: 0;
		max-width: 68ch;
	}
	.prep-list li {
		position: relative;
		padding-left: 38px;
		margin-bottom: 12px;
	}
	.prep-list li::before {
		content: "✓";
		position: absolute;
		left: 0;
		top: 1px;
		width: 26px;
		height: 26px;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: var(--pine-soft);
		color: var(--pine);
		font-size: 0.85rem;
		font-weight: 700;
	}

	.outro {
		background: var(--butter-soft);
		border-radius: var(--radius-l);
		padding: 48px 28px;
		text-align: center;
		margin-top: 80px;
	}
	.outro p {
		margin: 0 auto 24px;
		max-width: 48ch;
	}

	@media (max-width: 640px) {
		.next .btn {
			margin-left: 0;
		}
	}
</style>
