---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, BOOK_URL } from "../consts";
import { TASTERS, COURSES, parseDate, fmt } from "../data/sessions";

const buildToday = new Date();
buildToday.setHours(0, 0, 0, 0);
const isPast = (d: Date) => d.getTime() < buildToday.getTime();

const tasters = TASTERS.map((t) => ({ ...t, d: parseDate(t.date) })).sort(
	(a, b) => a.d.getTime() - b.d.getTime(),
);

const courses = COURSES.map((c) => {
	const isoSorted = [...c.dates].sort();
	return { ...c, ds: isoSorted.map(parseDate), startISO: isoSorted[0] };
}).sort((a, b) => (a.startISO < b.startISO ? -1 : 1));

const nextT = tasters.find((t) => !isPast(t.d));
function relTag(d: Date) {
	const days = Math.round((d.getTime() - buildToday.getTime()) / 86400000);
	if (days === 0) return "Today";
	if (days === 1) return "Tomorrow";
	if (days <= 7) return "This " + fmt(d, { weekday: "long" });
	return "Coming up";
}

const pageTitle = `Try archery | ${SITE_TITLE}`;
const pageDesc =
	"Book a taster session or a beginner's course with Aequus Archers in Milford, Derbyshire. All equipment provided, beginners welcome.";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDesc} />
	</head>
	<body>
		<Header />
		<main class="aeq">
			<div class="wrap">
				<span class="kicker">2026 season · now booking</span>
				<h1 class="hero-title">Upcoming sessions</h1>
				<p class="lede">
					Come and have a go. All equipment provided, total beginners welcome — just pick a date and
					reserve your place.
				</p>
				<p class="facts">
					All kit provided · beginners welcome · ages 8+ (110&nbsp;cm+) · Milford, Derbyshire
				</p>

				{
					nextT && (
						<div class="next" id="next-banner">
							<div class="cal">
								<div class="d">{nextT.d.getDate()}</div>
								<div class="m">{fmt(nextT.d, { month: "short" })}</div>
							</div>
							<div>
								<span class="tag">{relTag(nextT.d)}</span>
								<h2>Next taster session</h2>
								<p>
									{fmt(nextT.d, { weekday: "long", day: "numeric", month: "long" })} · {nextT.time} ·
									1.5 hrs · £15 (£10 under-16)
								</p>
							</div>
							<a class="btn" href={BOOK_URL}>Reserve a place</a>
						</div>
					)
				}

				<div class="grouphead">
					<h2>Taster sessions</h2><span class="price">£15 · £10 under-16</span>
				</div>
				<p class="groupsub">
					A one-off 1.5-hour session — perfect to try archery and see if it’s for you.
				</p>
				<div class="taster-grid">
					{
						tasters.map((t) => (
							<div class="tcard" data-date={t.date} data-time={t.time} hidden={isPast(t.d)}>
								<div class="bar" />
								<div class="body">
									<div class="day">{fmt(t.d, { weekday: "long" })}</div>
									<div class="date">{fmt(t.d, { day: "numeric", month: "short" })}</div>
									<div class="time">{t.time}</div>
									<div class="meta">{t.note ?? "1.5 hrs · kit provided"}</div>
									<span class="soontag" hidden>
										Next up
									</span>
									<div class="foot">
										<a href={BOOK_URL}>
											Reserve <span class="arrow">→</span>
										</a>
									</div>
								</div>
							</div>
						))
					}
				</div>
				<div class="empty" id="taster-empty" hidden>
					More taster dates coming soon — join the waiting list and we’ll let you know.
				</div>

				<div class="gap"></div>
				<div class="grouphead">
					<h2>Beginner courses</h2><span class="price">£90 · £45 under-18</span>
				</div>
				<p class="groupsub">
					Four weeks over consecutive weekends (3 hrs each). Learn the fundamentals, then earn your
					certificate — required to join any Archery GB club, including ours.
				</p>
				<div class="course-grid">
					{
						courses.map((c) => (
							<div class="ccard" data-start={c.startISO} hidden={isPast(c.ds[0])}>
								<span class="ctag">{c.ds.length}-week course</span>
								<h3>{c.name}</h3>
								<p class="sub">
									{fmt(c.ds[0], { weekday: "long" })}s · {c.times}
								</p>
								<ul class="dates">
									{c.ds.map((d, i) => (
										<li>
											<span class="pin">{i + 1}</span>{" "}
											{fmt(d, { weekday: "short", day: "numeric", month: "long" })}
										</li>
									))}
								</ul>
								<p class="perks">Certificate on completion · all sessions required · kit provided</p>
								<div class="priceline">
									<span class="big">£90</span> <span class="small">/ £45 under-18</span>
								</div>
								<a class="btn" href={BOOK_URL}>
									Join the {c.name}
								</a>
							</div>
						))
					}
				</div>
				<div class="empty" id="course-empty" hidden>
					Our next beginner course dates are being finalised — join the waiting list to hear first.
				</div>

				<div class="gap"></div>
				<h2 class="sechead">Session information</h2>
				<p class="lede">
					Book a taster session or a beginner course and discover this exciting sport with us.
				</p>
				<ul class="info-list">
					<li><strong>Where</strong> — our outdoor field in Milford, Derbyshire</li>
					<li><strong>When</strong> — throughout the summer season</li>
					<li><strong>How often</strong> — one taster a month · three courses a year</li>
				</ul>
				<p class="info-copy">
					Every session is led by an experienced archer, and all equipment is provided. We welcome
					participants of all ages and abilities — children must be at least 110&nbsp;cm tall to
					take part.
				</p>
				<div class="two-up">
					<div class="mini">
						<h4>Taster sessions — £15</h4>
						<p>
							A one-off 1.5-hour session that’s perfect if you’d like to try archery and see if
							it’s for you.
						</p>
					</div>
					<div class="mini">
						<h4>Beginner courses — £90 (£45 under-18)</h4>
						<p>
							A four-week course over consecutive weekends (3 hrs each). Finish all four to
							receive your certificate — required to join any Archery GB-affiliated club,
							including Aequus Archers.
						</p>
					</div>
				</div>

				<div class="gap"></div>
				<h2 class="sechead">How to prepare</h2>
				<p class="lede">A few things to help you enjoy your session safely and comfortably.</p>
				<ul class="prep-list">
					<li>Juniors (under 18) must be accompanied by a parent or guardian for the whole session.</li>
					<li>Let us know about any medical conditions or special needs that could affect taking part.</li>
					<li>
						Bring any essential medication, enough food and drink, and weather-appropriate clothing
						(and sunscreen on sunny days).
					</li>
					<li>Tie long hair back — clips or bobbles work well.</li>
					<li>
						Footwear: no open-toed shoes, sandals or flip-flops. Grass can be wet, so wear something
						suitable.
					</li>
					<li>Avoid loose clothing or drawstrings (like hoodies) — they can catch in the bow string.</li>
					<li>Facial piercings may need to be removed for safety.</li>
				</ul>

				<div class="outro">
					<h2>Ready to give it a go?</h2>
					<p>Pick a date above, then join the waiting list and we’ll be in touch.</p>
					<a class="btn big" href={BOOK_URL}>Join the waiting list</a>
				</div>
			</div>
		</main>
		<Footer />

		<script>
			const today = new Date();
			today.setHours(0, 0, 0, 0);
			const L = "en-GB";
			const f = (d: Date, o: Intl.DateTimeFormatOptions) =>
				new Intl.DateTimeFormat(L, o).format(d);
			const parse = (s: string) => new Date(s + "T00:00:00");

			const tcards = Array.from(
				document.querySelectorAll<HTMLElement>(".tcard[data-date]"),
			);
			let firstVisible: HTMLElement | null = null;
			tcards.forEach((c) => {
				const tag = c.querySelector<HTMLElement>(".soontag");
				if (tag) tag.hidden = true;
				const d = parse(c.dataset.date!);
				if (d < today) {
					c.hidden = true;
				} else if (!firstVisible) {
					firstVisible = c;
				}
			});

			const tEmpty = document.getElementById("taster-empty");
			const banner = document.getElementById("next-banner");
			if (firstVisible) {
				const card = firstVisible as HTMLElement;
				if (tEmpty) tEmpty.hidden = true;
				const tag = card.querySelector<HTMLElement>(".soontag");
				if (tag) tag.hidden = false;
				if (banner) {
					const d = parse(card.dataset.date!);
					const time = card.dataset.time!;
					const days = Math.round((d.getTime() - today.getTime()) / 86400000);
					const rel =
						days === 0
							? "Today"
							: days === 1
								? "Tomorrow"
								: days <= 7
									? "This " + f(d, { weekday: "long" })
									: "Coming up";
					banner.querySelector(".d")!.textContent = String(d.getDate());
					banner.querySelector(".m")!.textContent = f(d, { month: "short" });
					banner.querySelector(".tag")!.textContent = rel;
					banner.querySelector("p")!.textContent =
						f(d, { weekday: "long", day: "numeric", month: "long" }) +
						" · " +
						time +
						" · 1.5 hrs · £15 (£10 under-16)";
					banner.hidden = false;
				}
			} else {
				if (tEmpty) tEmpty.hidden = false;
				if (banner) banner.hidden = true;
			}

			let anyCourse = false;
			document
				.querySelectorAll<HTMLElement>(".ccard[data-start]")
				.forEach((c) => {
					if (parse(c.dataset.start!) < today) c.hidden = true;
					else anyCourse = true;
				});
			const cEmpty = document.getElementById("course-empty");
			if (cEmpty) cEmpty.hidden = anyCourse;
		</script>

		<style>
			[hidden] {
				display: none !important;
			}
			.wrap {
				max-width: 1040px;
				margin: 0 auto;
				padding: 32px 20px 44px;
			}
			.kicker {
				display: inline-block;
				color: var(--aeq-accent-text);
				font-weight: 700;
				font-size: 0.875rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
			.hero-title {
				font-size: 2.375rem;
				line-height: 1.1;
				margin: 12px 0 8px;
				color: var(--aeq-primary-dark);
				font-weight: 700;
			}
			.lede {
				font-size: 1.0625rem;
				color: var(--aeq-muted);
				max-width: 560px;
				margin: 0 0 10px;
			}
			.facts {
				color: var(--aeq-muted);
				font-size: 1rem;
				margin: 0 0 28px;
			}
			.sechead {
				font-size: 1.625rem;
				font-weight: 700;
				color: var(--aeq-primary-dark);
				margin: 0 0 6px;
			}
			.gap {
				margin-top: 44px;
			}
			.next {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 18px;
				background: var(--aeq-primary);
				color: #fff;
				border-radius: var(--aeq-radius);
				padding: 22px 24px;
				margin-bottom: 34px;
			}
			.next .cal {
				background: rgba(255, 255, 255, 0.14);
				border-radius: 12px;
				padding: 10px 16px;
				text-align: center;
				min-width: 74px;
			}
			.next .cal .d {
				font-family: var(--aeq-font-display);
				font-size: 1.75rem;
				font-weight: 700;
				line-height: 1;
			}
			.next .cal .m {
				font-size: 0.875rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				opacity: 0.9;
				margin-top: 4px;
			}
			.next .tag {
				display: inline-block;
				color: var(--aeq-accent-soft);
				font-weight: 700;
				font-size: 0.875rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				margin-bottom: 4px;
			}
			.next h2 {
				margin: 0;
				font-size: 1.375rem;
				font-weight: 700;
				color: #fff;
			}
			.next p {
				margin: 2px 0 0;
				opacity: 0.92;
				font-size: 1rem;
			}
			.btn {
				display: inline-block;
				background: var(--aeq-accent);
				color: #fff;
				font-weight: 700;
				font-size: 1.0625rem;
				text-decoration: none;
				padding: 12px 24px;
				border-radius: 999px;
			}
			.btn:hover {
				filter: brightness(1.05);
			}
			.btn.big {
				font-size: 1.125rem;
				padding: 14px 30px;
			}
			.next .btn {
				margin-left: auto;
			}
			.grouphead {
				display: flex;
				align-items: baseline;
				gap: 12px;
				margin: 0 0 4px;
			}
			.grouphead h2 {
				font-size: 1.5rem;
				font-weight: 700;
				color: var(--aeq-primary-dark);
				margin: 0;
			}
			.grouphead .price {
				font-size: 1rem;
				font-weight: 700;
				color: var(--aeq-accent-text);
			}
			.groupsub {
				color: var(--aeq-muted);
				font-size: 1rem;
				margin: 0 0 16px;
				max-width: 580px;
			}
			.taster-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
				gap: 14px;
			}
			.tcard {
				background: #fff;
				border: 1px solid var(--aeq-line);
				border-radius: var(--aeq-radius);
				overflow: hidden;
				display: flex;
				flex-direction: column;
			}
			.tcard .bar {
				height: 6px;
				background: var(--aeq-blue);
			}
			.tcard .body {
				padding: 14px;
				display: flex;
				flex-direction: column;
				flex: 1;
			}
			.tcard .day {
				font-size: 0.875rem;
				font-weight: 700;
				color: var(--aeq-muted);
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.tcard .date {
				font-family: var(--aeq-font-display);
				font-size: 1.5rem;
				font-weight: 700;
				color: var(--aeq-primary-dark);
			}
			.tcard .time {
				font-size: 1rem;
				font-weight: 600;
			}
			.tcard .meta {
				font-size: 1rem;
				color: var(--aeq-muted);
				margin-top: 6px;
			}
			.tcard .soontag {
				display: inline-block;
				color: var(--aeq-accent-text);
				font-weight: 700;
				font-size: 0.875rem;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				margin-top: 8px;
			}
			.tcard .foot {
				margin-top: auto;
				padding-top: 12px;
			}
			.tcard .foot a {
				display: inline-block;
				font-weight: 700;
				color: var(--aeq-primary-dark);
				text-decoration: none;
				font-size: 1rem;
				padding: 8px 0;
			}
			.tcard .foot a .arrow {
				color: var(--aeq-accent);
			}
			.course-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
				gap: 18px;
			}
			.ccard {
				background: #fff;
				border: 1px solid var(--aeq-line);
				border-radius: var(--aeq-radius);
				padding: 22px;
			}
			.ctag {
				display: inline-block;
				color: var(--aeq-primary);
				font-weight: 700;
				font-size: 0.875rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
			}
			.ccard h3 {
				font-size: 1.375rem;
				font-weight: 700;
				color: var(--aeq-primary-dark);
				margin: 8px 0 2px;
			}
			.ccard .sub {
				color: var(--aeq-muted);
				font-size: 1rem;
				margin: 0 0 14px;
			}
			.dates {
				list-style: none;
				padding: 0;
				margin: 0 0 16px;
				display: flex;
				flex-direction: column;
				gap: 8px;
			}
			.dates li {
				display: flex;
				align-items: center;
				gap: 10px;
				font-size: 1rem;
				font-weight: 600;
			}
			.dates li .pin {
				color: var(--aeq-accent-text);
				font-size: 1rem;
				font-weight: 700;
				min-width: 18px;
				flex: 0 0 auto;
			}
			.perks {
				font-size: 1rem;
				color: var(--aeq-muted);
				border-top: 1px dashed var(--aeq-line);
				padding-top: 12px;
				margin: 0 0 14px;
			}
			.priceline {
				margin-bottom: 14px;
			}
			.priceline .big {
				font-family: var(--aeq-font-display);
				font-size: 1.5rem;
				font-weight: 700;
				color: var(--aeq-primary-dark);
			}
			.priceline .small {
				font-size: 1rem;
				color: var(--aeq-muted);
			}
			.empty {
				color: var(--aeq-muted);
				font-style: italic;
				font-size: 1rem;
				margin-top: 14px;
			}
			.info-list {
				list-style: none;
				padding: 0;
				margin: 0 0 16px;
			}
			.info-list li {
				font-size: 1.0625rem;
				margin-bottom: 6px;
			}
			.info-copy {
				margin: 0 0 14px;
				font-size: 1.0625rem;
				max-width: 70ch;
			}
			.two-up {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				gap: 28px;
				margin-top: 20px;
			}
			.mini {
				border-top: 2px solid var(--aeq-line);
				padding-top: 14px;
			}
			.mini h4 {
				margin: 0 0 4px;
				font-size: 1.0625rem;
				font-weight: 700;
				color: var(--aeq-primary-dark);
			}
			.mini p {
				margin: 0;
				font-size: 1rem;
				color: var(--aeq-muted);
			}
			.prep-list {
				list-style: none;
				padding: 0;
				margin: 0;
				max-width: 70ch;
			}
			.prep-list li {
				position: relative;
				padding-left: 28px;
				margin-bottom: 10px;
				font-size: 1.0625rem;
			}
			.prep-list li::before {
				content: "✓";
				position: absolute;
				left: 0;
				color: var(--aeq-accent);
				font-weight: 700;
			}
			.outro {
				text-align: center;
				margin-top: 56px;
				padding-top: 40px;
				border-top: 2px solid var(--aeq-line);
			}
			.outro h2 {
				margin: 0 0 6px;
				font-size: 1.625rem;
				font-weight: 700;
				color: var(--aeq-primary-dark);
			}
			.outro p {
				margin: 0 auto 20px;
				color: var(--aeq-muted);
				font-size: 1.0625rem;
				max-width: 50ch;
			}
		</style>
	</body>
</html>
