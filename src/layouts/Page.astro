---
import Base from "./Base.astro";
import { SITE_TITLE } from "../consts";

interface Props {
	title: string;
	description?: string;
	intro?: string;
	kicker?: string;
}

const { title, description = "", intro = "", kicker = "" } = Astro.props;
---

<Base title={`${title} | ${SITE_TITLE}`} description={description || title}>
	<section class="page-head">
		<div class="wrap">
			{kicker && <p class="kicker">{kicker}</p>}
			<h1>{title}</h1>
			{intro && <p class="lede">{intro}</p>}
		</div>
	</section>
	<div class="wrap page-body">
		<slot />
	</div>
</Base>

<style>
	.page-head {
		padding: 56px 0 8px;
	}
	.page-head h1 {
		max-width: 20ch;
		margin-bottom: 14px;
	}
	.page-head .lede {
		margin: 0;
	}
	.page-body {
		padding-top: 40px;
	}
</style>
<style is:global>
	.page-body > section {
		margin-bottom: 64px;
	}
	.page-body h2 {
		font-size: clamp(1.6rem, 3vw, 2rem);
	}
	.page-body p {
		max-width: 68ch;
	}
	.page-body .outro {
		background: var(--pine-soft);
		border-radius: var(--radius-l);
		padding: 44px 28px;
		text-align: center;
	}
	.page-body .outro p {
		margin-left: auto;
		margin-right: auto;
	}
	.page-body .actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		justify-content: center;
	}
</style>
