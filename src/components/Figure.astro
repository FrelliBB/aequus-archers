---
import { Image } from "astro:assets";
import { photo } from "../lib/images";

/*
  Inline photo with an optional caption.

  `src` is a path inside src/assets/images, e.g. "community/club-day.jpg".
  To swap a placeholder for a real photo, drop the new file in at the same path.

  align: "right" | "left" | "full"  (right/left float beside text on desktop,
                                     full spans the column; all stack on mobile)
  ratio: CSS aspect-ratio, e.g. "4 / 3" (default) or "3 / 2"
  accent: colour block offset behind the photo
*/
interface Props {
	src: string;
	alt: string;
	caption?: string;
	align?: "right" | "left" | "full";
	ratio?: string;
	accent?: "butter" | "sage" | "none";
	eager?: boolean;
}
const {
	src,
	alt,
	caption = "",
	align = "right",
	ratio = "4 / 3",
	accent = "none",
	eager = false,
} = Astro.props;
---

<figure class:list={["fig", align]}>
	<Image
		class:list={["photo", { "photo--offset": accent === "butter", "photo--offset-sage": accent === "sage" }]}
		src={photo(src)}
		alt={alt}
		widths={[480, 800, 1200]}
		sizes={align === "full" ? "(max-width: 1080px) 100vw, 1040px" : "(max-width: 760px) 100vw, 440px"}
		loading={eager ? "eager" : "lazy"}
		style={`aspect-ratio:${ratio}`}
	/>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.fig {
		margin: 0 0 24px;
	}
	figcaption {
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1rem;
		color: var(--muted);
		margin-top: 18px;
		line-height: 1.45;
	}
	.right,
	.left {
		max-width: 420px;
	}
	@media (min-width: 760px) {
		.right {
			float: right;
			width: 42%;
			margin: 6px 14px 20px 36px;
		}
		.left {
			float: left;
			width: 42%;
			margin: 6px 36px 20px 14px;
		}
	}
</style>
