---
import {
	SITE_TITLE,
	CLUB_RECORDS_URL,
	INSTAGRAM_URL,
	FACEBOOK_URL,
	CONTACT_EMAIL,
} from "../consts";
const today = new Date();
---

<footer>
	<div class="wrap grid">
		<div class="about">
			<p class="name">{SITE_TITLE}</p>
			<p>
				A volunteer-run target archery club in Milford, Derbyshire. Shooting together since 2012.
			</p>
			<a class="mail" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
		</div>
		<div>
			<p class="head">Get started</p>
			<ul>
				<li><a href="/sessions">Tasters &amp; courses</a></li>
				<li><a href="/faq">FAQ</a></li>
				<li><a href="/about#membership">Membership</a></li>
				<li><a href="/contact">Contact</a></li>
			</ul>
		</div>
		<div>
			<p class="head">The club</p>
			<ul>
				<li><a href="/about">About us</a></li>
				<li><a href="/committee">Meet the team</a></li>
				<li><a href="/events">Events</a></li>
				<li><a href="/archery">Archery info</a></li>
				<li><a href="/policies">Policies</a></li>
				<li><a href={CLUB_RECORDS_URL} target="_blank" rel="noopener">Club records</a></li>
			</ul>
		</div>
		<div>
			<p class="head">Say hello</p>
			<div class="social">
				<a href={INSTAGRAM_URL} target="_blank" rel="noopener" aria-label="Aequus Archers on Instagram">
					<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"
						><path
							fill="currentColor"
							d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM12 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"
						></path></svg
					>
				</a>
				<a href={FACEBOOK_URL} target="_blank" rel="noopener" aria-label="Aequus Archers on Facebook">
					<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"
						><path
							fill="currentColor"
							d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
						></path></svg
					>
				</a>
			</div>
		</div>
	</div>
	<div class="wrap base">
		<p>&copy; {today.getFullYear()} {SITE_TITLE}. Run by volunteers, with thanks to everyone who helps out.</p>
	</div>
</footer>
<style>
	footer {
		background: var(--pine);
		color: var(--pine-soft);
		padding: 56px 0 28px;
		margin-top: 80px;
		border-radius: var(--radius-l) var(--radius-l) 0 0;
	}
	.grid {
		display: grid;
		grid-template-columns: 1.6fr 1fr 1fr 0.8fr;
		gap: 32px;
	}
	.name {
		font-family: var(--font-display);
		font-variation-settings: "SOFT" 100, "WONK" 1;
		font-size: 1.5rem;
		font-weight: 600;
		color: var(--paper);
		margin: 0 0 8px;
	}
	.about p:not(.name) {
		font-size: 1rem;
		max-width: 34ch;
	}
	.head {
		font-family: var(--font-display);
		font-style: italic;
		color: var(--butter);
		font-size: 1.0625rem;
		margin: 0 0 10px;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	a {
		color: var(--paper);
		text-decoration: none;
		font-size: 1rem;
	}
	li a {
		display: inline-block;
		padding: 5px 0;
	}
	a:hover {
		color: var(--butter);
		text-decoration: underline;
	}
	.mail {
		font-weight: 600;
	}
	.social {
		display: flex;
		gap: 6px;
		margin-left: -11px;
	}
	.social a {
		display: flex;
		padding: 11px;
		border-radius: 999px;
	}
	.base {
		margin-top: 40px;
		padding-top: 20px;
		border-top: 1px solid rgba(220, 231, 221, 0.2);
	}
	.base p {
		margin: 0;
		font-size: 0.9rem;
		opacity: 0.85;
	}
	@media (max-width: 820px) {
		.grid {
			grid-template-columns: 1fr 1fr;
		}
		.about {
			grid-column: 1 / -1;
		}
	}
</style>
