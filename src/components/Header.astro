---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE, CLUB_RECORDS_URL } from "../consts";
---

<header>
	<nav class="wrap">
		<a class="brand" href="/">
			<img src="/images/logo.png" alt="" width="46" height="32" />
			<span>{SITE_TITLE}</span>
		</a>
		<button class="nav-toggle" aria-expanded="false" aria-controls="nav-links">
			<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"
				><path fill="currentColor" d="M3 6h18v2H3zM3 11h18v2H3zM3 16h18v2H3z"></path></svg
			>
			<span>Menu</span>
		</button>
		<div class="links" id="nav-links">
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/events">Events</HeaderLink>
			<HeaderLink href="/faq">FAQ</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
			<a href={CLUB_RECORDS_URL} target="_blank" rel="noopener">Club records</a>
			<a class="btn cta" href="/sessions">Try archery</a>
		</div>
	</nav>
</header>
<style>
	header {
		background: var(--paper);
		border-bottom: 1px solid var(--line);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
		min-height: 76px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		color: var(--pine);
		font-family: var(--font-display);
		font-variation-settings: "SOFT" 100, "WONK" 1;
		font-weight: 600;
		font-size: 1.3rem;
		padding: 10px 0;
	}
	.brand img {
		height: 32px;
		width: auto;
	}
	.links {
		display: flex;
		align-items: center;
		gap: 4px;
	}
	.links a:not(.btn) {
		color: var(--pine);
		text-decoration: none;
		font-size: 1rem;
		font-weight: 600;
		padding: 8px 12px;
		border-radius: 999px;
	}
	.links a:not(.btn):hover {
		background: var(--paper-deep);
	}
	.links :global(a.active) {
		background: var(--pine-soft);
	}
	.cta {
		margin-left: 10px;
		padding: 10px 20px;
		font-size: 1rem;
	}
	.nav-toggle {
		display: none;
		align-items: center;
		gap: 6px;
		background: none;
		border: 0;
		cursor: pointer;
		color: var(--pine);
		font: 700 1rem var(--font-body);
		padding: 10px 12px;
		border-radius: 999px;
	}
	@media (max-width: 860px) {
		.nav-toggle {
			display: inline-flex;
		}
		.links {
			display: none;
			width: 100%;
			flex-direction: column;
			align-items: stretch;
			gap: 2px;
			padding-bottom: 16px;
		}
		.links.open {
			display: flex;
		}
		.links a:not(.btn) {
			padding: 12px 14px;
		}
		.cta {
			margin: 8px 0 0;
			justify-content: center;
		}
	}
</style>
<script>
	const toggle = document.querySelector(".nav-toggle");
	const menu = document.getElementById("nav-links");
	toggle?.addEventListener("click", () => {
		const open = menu?.classList.toggle("open");
		toggle.setAttribute("aria-expanded", String(!!open));
	});
</script>
