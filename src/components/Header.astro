---
import HeaderLink from "./HeaderLink.astro";
import {
	SITE_TITLE,
	CLUB_RECORDS_URL,
	INSTAGRAM_URL,
	FACEBOOK_URL,
} from "../consts";

const logo = "/images/logo.png";
---

<header>
	<nav>
		<a class="brand" href="/">
			<img src={logo} alt="" width="40" height="28" />
			<span>{SITE_TITLE}</span>
		</a>
		<button class="nav-toggle" aria-expanded="false" aria-controls="nav-links">
			<svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"
				><path fill="currentColor" d="M3 6h18v2H3zM3 11h18v2H3zM3 16h18v2H3z"></path></svg
			>
			<span>Menu</span>
		</button>
		<div class="internal-links" id="nav-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/sessions">Try archery</HeaderLink>
			<HeaderLink href="/events">Events</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
			<a class="ext" href={CLUB_RECORDS_URL} target="_blank" rel="noopener">Club records</a>
		</div>
		<div class="social-links">
			<a href={INSTAGRAM_URL} target="_blank" rel="noopener" aria-label="Aequus Archers on Instagram">
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"
					><path
						fill="currentColor"
						d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM12 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"
					></path></svg
				>
			</a>
			<a href={FACEBOOK_URL} target="_blank" rel="noopener" aria-label="Aequus Archers on Facebook">
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"
					><path
						fill="currentColor"
						d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #fff;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
		max-width: 1100px;
		margin: 0 auto;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		color: var(--aeq-primary-dark);
		font-family: var(--aeq-font-display);
		font-weight: 700;
		font-size: 1.1875rem;
		padding: 10px 0;
	}
	.brand img {
		height: 28px;
		width: auto;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 2px;
		flex-wrap: wrap;
	}
	nav a {
		padding: 1em 0.6em;
		color: var(--aeq-ink);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		font-size: 1rem;
		font-weight: 600;
	}
	nav a:hover {
		color: var(--aeq-primary);
	}
	nav a.active {
		border-bottom-color: var(--aeq-accent);
	}
	.social-links {
		display: flex;
		gap: 4px;
	}
	.social-links a {
		display: flex;
		/* 22px icon + 2 × 11px = 44px minimum touch target */
		padding: 11px;
		color: var(--aeq-accent);
		border-bottom: none;
	}
	.social-links a:hover {
		color: var(--aeq-accent-text);
	}
	.nav-toggle {
		display: none;
		align-items: center;
		gap: 6px;
		background: none;
		border: 0;
		cursor: pointer;
		color: var(--aeq-primary-dark);
		font-size: 1rem;
		font-weight: 700;
		padding: 9px 10px;
		margin-left: auto;
	}
	@media (max-width: 820px) {
		.nav-toggle {
			display: inline-flex;
		}
		.internal-links {
			display: none;
			width: 100%;
			flex-direction: column;
			align-items: flex-start;
			gap: 0;
			padding-bottom: 8px;
		}
		.internal-links.open {
			display: flex;
		}
		.internal-links a {
			width: 100%;
			padding: 14px 4px;
			border-bottom: 1px solid var(--aeq-line);
		}
		.social-links {
			display: none;
		}
	}
</style>
<script>
	const toggle = document.querySelector(".nav-toggle");
	const menu = document.getElementById("nav-links");
	toggle?.addEventListener("click", () => {
		const open = menu?.classList.toggle("open");
		toggle.setAttribute("aria-expanded", String(!!open));
	});
</script>
